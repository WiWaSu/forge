{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ответ нейросети: технологический маршрут",
  "description": "Схема ответа модели на запрос построения маршрута. Проверяется движком в engine/llm/validate.py; структурная проверка дополняется семантической — коды операций и оборудование сверяются со справочником knowledge/reference/operations.json.",
  "type": "object",
  "required": ["process", "operations"],
  "additionalProperties": false,
  "properties": {
    "process": {
      "type": "string",
      "description": "Код техпроцесса, скопированный из расчёта без изменений",
      "enum": ["die_forging_hammer", "die_forging_press", "die_forging_hcm", "free_forging"]
    },
    "operations": {
      "type": "array",
      "description": "Операции маршрута в технологической последовательности",
      "minItems": 4,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["number", "code", "name", "equipment", "rationale"],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "pattern": "^[0-9]{3}$",
            "description": "Номер операции, кратный пяти: 005, 010, 015 ..."
          },
          "code": {
            "type": "string",
            "description": "Код операции из справочника operations.json"
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 60,
            "description": "Наименование операции из справочника"
          },
          "equipment": {
            "type": "string",
            "description": "Код оборудования, разрешённого для этой операции; пустая строка для операций без оборудования"
          },
          "rationale": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300,
            "description": "Одна фраза с опорой на данные расчёта"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 400,
      "description": "Одна-две фразы о маршруте в целом"
    }
  }
}
